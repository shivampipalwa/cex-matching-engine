# Copy to deploy/.env and fill in. docker compose reads this automatically.

# A hostname gets automatic HTTPS from Let's Encrypt. Use :80 for a local
# stack, or when testing before DNS points at the box.
SITE_ADDRESS=exchange.example.com

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-something-long-and-random

# The account allowed to list/delist markets. 1 on a fresh database, which is
# whichever account signs up first — so sign up as yourself before sharing the
# URL, or the first visitor gets it.
ADMIN_ACCOUNT_ID=1

# Built frontend, relative to deploy/. Run `npm run build` in the frontend
# repo first.
FRONTEND_DIST=../../fe/dist

# Market maker
BOT_PASSWORD=change-me-too
BOT_PAIR=SOL-USD
BOT_TICK_MS=4000
