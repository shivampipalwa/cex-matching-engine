# Copy to deploy/.env and fill in. docker compose reads this automatically.

# A hostname gets automatic HTTPS from Let's Encrypt. Use :80 for a local
# stack, or when testing before DNS points at the box.
SITE_ADDRESS=exchange.example.com

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-something-long-and-random

# The account allowed to list/delist markets. 1 on a fresh database, which is
# whichever account signs up first — so sign up as yourself before sharing the
# URL, or the first visitor gets it.
ADMIN_ACCOUNT_ID=1

# Built frontend, relative to deploy/. Run `npm run build` in the frontend
# repo first.
FRONTEND_DIST=../../fe/dist

# Market maker
BOT_PASSWORD=change-me-too
BOT_PAIR=SOL-USD
BOT_TICK_MS=4000

# Retention, swept hourly by db_writer. 0 = keep forever. Only terminal
# (filled/cancelled) orders are ever pruned; open ones are never touched.
# The chart reads `candles`, not `trades`, so pruning trades no longer
# shortens it — candles outlive the trades they were built from.
ORDER_RETENTION_DAYS=7
TRADE_RETENTION_DAYS=365
# Only 1s candles are pruned. At 86,400 rows/day/pair they'd dwarf every other
# width put together; 15m and coarser are small enough to keep forever, so
# chart history at those intervals is unbounded regardless of this.
CANDLE_1S_RETENTION_DAYS=2
